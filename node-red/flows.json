    {
        "id": "8d47ba10092938c0",
        "type": "function",
        "z": "267a804e8fd0c894",
        "name": "Validar e preparar telemetria",
        "func": "// Aceita JSON publicado no tópico enchente/<ponto>/telemetria.\n// Exemplo: {\"nivel_agua_cm\":85.5,\"chuva_mm\":12.4,\"data_hora\":\"2026-11-06T08:00:00\"}\nlet dados = msg.payload;\nif (typeof dados === \"string\") {\n    try { dados = JSON.parse(dados); }\n    catch (e) { node.warn(\"Payload MQTT não contém JSON válido.\"); return null; }\n}\nconst topico = String(msg.topic || \"\");\nconst match = topico.match(/^enchente\\/([A-Za-z0-9_-]+)\\/telemetria$/);\nif (!match || !dados || typeof dados !== \"object\") {\n    node.warn(\"Tópico ou estrutura da telemetria inválida.\"); return null;\n}\nconst ponto = match[1];\nconst nivel = Number(dados.nivel_agua_cm);\nconst chuva = Number(dados.chuva_mm ?? 0);\nconst dataHora = dados.data_hora || new Date().toISOString();\nconst instante = Date.parse(dataHora);\nif (!Number.isFinite(nivel) || nivel < 0 || nivel > 1000 ||\n    !Number.isFinite(chuva) || chuva < 0 || chuva > 1000 ||\n    !Number.isFinite(instante)) {\n    node.warn(\"Medição inválida: confira nível, chuva e data_hora.\"); return null;\n}\nconst anterior = context.get(\"ultima_\" + ponto);\nlet elevacao = 0;\nif (anterior && instante > anterior.instante) {\n    const horas = (instante - anterior.instante) / 3600000;\n    elevacao = (nivel - anterior.nivel) / horas;\n}\ncontext.set(\"ultima_\" + ponto, {nivel, instante});\nconst medicao = {\n    ponto_monitoramento: ponto,\n    nivel_agua_cm: nivel,\n    chuva_mm: chuva,\n    elevacao_cm_h: Number(elevacao.toFixed(2)),\n    data_hora: new Date(instante).toISOString()\n};\nconst sql = {\n    topic: \"INSERT INTO leituras_enchente (ponto_monitoramento, nivel_agua_cm, chuva_mm, elevacao_cm_h, data_hora) VALUES (\" +\n        \"'\" + ponto + \"', \" + nivel + \", \" + chuva + \", \" + medicao.elevacao_cm_h + \", '\" +\n        medicao.data_hora.slice(0,19).replace(\"T\",\" \") + \"')\"\n};\nconst gaugeNivel = {payload:nivel};\nconst gaugeChuva = {payload:chuva};\nconst chart = {payload:nivel, topic:\"Ponto \" + ponto};\nconst paraML = {payload:medicao, headers:{\"Content-Type\":\"application/json\"}};\nreturn [sql, gaugeNivel, gaugeChuva, chart, paraML];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 180,
        "wires": [
