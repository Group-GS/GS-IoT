    {
        "id": "4b1e92eb7e6b1a30",
        "type": "function",
        "z": "267a804e8fd0c894",
        "name": "Preparar contexto para IA generativa",
        "func": "// Recebe a resposta do endpoint POST /predict.\n// Contrato esperado: classificacao, probabilidade e fatores.\nconst resultado = (msg.payload && typeof msg.payload === \"object\") ? msg.payload : {};\nconst classificacao = String(resultado.classificacao || \"INDEFINIDO\").toUpperCase();\nconst medicao = flow.get(\"ultima_medicao\") || {};\n\nif (!medicao || Object.keys(medicao).length === 0) {\n    node.warn(\"A medição original não foi encontrada no contexto do fluxo.\");\n}\n\nconst entrada = {\n    classificacao: classificacao,\n    probabilidade: resultado.probabilidade !== undefined ? resultado.probabilidade : null,\n    fatores: Array.isArray(resultado.fatores) ? resultado.fatores : [],\n    medicoes: medicao\n};\n\nmsg.classificacao = classificacao;\nmsg.payload = {\n    instrucoes: \"Escreva um alerta curto, claro e responsável em português do Brasil. Explique o nível de risco usando somente os dados recebidos. Não invente medições, não altere a classificação e recomende acompanhar os canais oficiais da Defesa Civil. Se o risco for elevado, oriente procurar local seguro conforme orientações oficiais.\",\n    dados: entrada\n};\nmsg.headers = { \"Content-Type\": \"application/json\", \"Accept\": \"application/json\" };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1530,
        "y": 300,
        "wires": [
