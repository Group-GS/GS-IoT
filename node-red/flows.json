        "func": "const detalhe = (msg.error && msg.error.message) ? msg.error.message : \"Falha de comunicação com a API generativa.\";\nconst classificacao = String(msg.classificacao || \"INDEFINIDO\").toUpperCase();\nmsg.payload = {\n    alerta: \"Classificação do Machine Learning: \" + classificacao + \". A explicação por IA generativa está indisponível neste momento e esta mensagem não foi gerada por um modelo de linguagem. Acompanhe os canais oficiais da Defesa Civil e siga as orientações das autoridades locais. Detalhe técnico: \" + detalhe\n};\nmsg.topic = \"Contingência da IA generativa\";\nreturn msg;",
