        "func": "const detalhe = (msg.error && msg.error.message) ? msg.error.message : \"Falha de comunicação com a API de Machine Learning.\";\nmsg.payload = \"Não foi possível classificar o risco: a API de Machine Learning está indisponível. Verifique se o serviço está ativo em http://127.0.0.1:8000. Detalhe: \" + detalhe;\nmsg.topic = \"Erro na classificação ML\";\nreturn msg;",
